# ECS 端 cron service：每周五 newsletter 汇总推送
# 对应 vercel.json：{ "path": "/api/cron/newsletter", "schedule": "0 1 * * 5" }（UTC）
# 部署位置：/etc/systemd/system/f1frp-cron-newsletter.service
[Unit]
Description=f1frp weekly newsletter cron
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/var/www/f1frp/.env.production.local
ExecStart=/usr/bin/bash -c 'curl -fsS --max-time 300 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/newsletter'
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
