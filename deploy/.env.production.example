# f1frp.com 国内侧 ECS 环境变量模板
# 部署位置：/var/www/f1frp/.env.production.local
# 复制本文件为 .env.production.local 后填实际值
# 切勿提交到 git

# ─── 部署侧标识 ───────────────────────────────────
AI_PROFILE=domestic
# 不要设 CHAT_PROVIDER — host 分流(provider.ts)在 f1frp.com 上强制 DeepSeek。
# 此 env 仅对 localhost/preview 生效;在生产域名上设置会被忽略
# (2026-05-18 commit 4120e6c 后的硬规则,防止误改 env 走错 provider)
NEXT_PUBLIC_LOCALES=zh
NEXT_PUBLIC_DEFAULT_LOCALE=zh
NEXT_PUBLIC_SITE_URL=https://f1frp.com
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_SITE_DESCRIPTION=

# 国内 ICP 备案号（footer 自动展示）
NEXT_PUBLIC_ICP_BEIAN=蜀ICP备XXXXXXXX号

# 运行时
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# ─── 数据库（与 Vercel 共用 Neon Postgres / 新加坡 region）──
DATABASE_URL=postgres://...

# ─── Auth（自建手机 + 微信认证，已替换 Clerk）─────
# 会话 cookie 的 HMAC 签名密钥。生成：openssl rand -hex 32（≥16 字节，必填）
AUTH_SESSION_SECRET=

# 阿里云短信（手机验证码登录，必填才能发码）。短信凭证与 OSS 凭证通常不同,请分开配置。
# 控制台 → 短信服务 → 签名管理 / 模板管理。模板正文需含 ${code} 变量。
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=            # 短信签名,如「复材在线」
ALIYUN_SMS_TEMPLATE_CODE=        # 模板 CODE,如 SMS_123456789
# ALIYUN_SMS_REGION=cn-hangzhou  # 可选,默认 cn-hangzhou

# 微信网页扫码登录（开放平台网站应用）。留空 → 登录页「微信登录」显示为「即将开放」。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ─── AI provider (2026-05-22 现状) ────────────────
# Chat:  f1frp.com → DeepSeek (host 强制,provider.ts:71)
# Embed: 两侧都用 Google gemini-embedding-001 (向量空间一致),国内走 CF gateway

# DeepSeek — f1frp.com chat 主路径 (必填)
DEEPSEEK_API_KEY=sk-...

# ── Embedding provider (RAG 向量化) ──
# 推荐 dashscope (阿里通义) — 同阿里云区,~100ms 延迟,无需 gateway,免费 100M tokens × 90 天
# 切换 provider 后必须跑 `pnpm tsx --env-file=.env.local scripts/reindex-embeddings.ts`
# 重算所有向量,否则 RAG 检索返回语义垃圾
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-...

# 旧 Google 路径（EMBEDDING_PROVIDER=google 时启用）—— 国内必须配 gateway
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GOOGLE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gw>/google-ai-studio/v1beta

# OpenRouter — 已降级为非生产 fallback,仅 localhost/preview 通过 CHAT_PROVIDER=openrouter 显式启用
# OPENROUTER_API_KEY=sk-or-v1-...

# ─── Web Search Tool (Tavily) ─────────────────────
# 给 AI 开 web_search 工具。未设时 graceful degrade（不传 tools 给 LLM）。
# 免费 1000 次/月。https://app.tavily.com → API Keys → 复制 tvly-xxx
# 实测 ECS 可达 (~3s),无需 gateway 代理
TAVILY_API_KEY=tvly-...

# ─── Cron 自调用密钥（systemd timer 用）────────────
# 生成：openssl rand -hex 32
CRON_SECRET=

# ─── 站长平台验证（可选）──────────────────────────
GOOGLE_SITE_VERIFICATION=        # Google Search Console HTML tag method
BAIDU_SITE_VERIFICATION=
SOGOU_SITE_VERIFICATION=
SHENMA_SITE_VERIFICATION=
SM_SITE_VERIFICATION=
BYTEDANCE_VERIFICATION=

# ─── 阿里云 OSS（支付凭证 + 用户上传文件存储）──────
# bucket 建议放与 ECS 同 region（华东 1 杭州）减少延迟和流量费
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_ACCESS_SECRET=

# ─── Telegram 通知（cron ingest 用，可选）─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
